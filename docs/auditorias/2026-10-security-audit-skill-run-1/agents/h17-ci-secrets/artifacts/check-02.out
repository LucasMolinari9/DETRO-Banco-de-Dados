## .github/workflows/db-checks.yml
  triggers=['pull_request', 'push', 'schedule', 'workflow_dispatch'] permissions={'contents': 'read'}
  job realtime: if="github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository" environment=None job_env_secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] permissions=(workflow)
    checkout persist-credentials=False ref=DEFAULT(event ref)
    step 'Instalar cliente PostgreSQL': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=[]
    step 'RT_TABLES (app.js) x publicacao supabase_realtime': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=['scripts/check_realtime.mjs']
  job qualidade: if="github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository" environment=None job_env_secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] permissions=(workflow)
    checkout persist-credentials=False ref=DEFAULT(event ref)
    step 'Instalar cliente PostgreSQL': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=[]
    step 'Qualidade dos dados pos-ETL (orfaos referenciais, U+FFFD)': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=['scripts/check_data_quality.mjs']
  job seguranca: if="github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository" environment=None job_env_secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] permissions=(workflow)
    checkout persist-credentials=False ref=DEFAULT(event ref)
    step 'Instalar cliente PostgreSQL': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=[]
    step 'Regressao do gate (permissoes perigosas e bloqueios RESTRICTIVE)': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=['tests/check_grants.rig.mjs']
    step 'RLS, grants, policies e privilegios de funcao': secrets=['SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=['scripts/check_grants.mjs']

## .github/workflows/deploy-smoke.yml
  triggers=['deployment_status', 'workflow_dispatch'] permissions={'contents': 'read'}
  job smoke: if="github.event_name == 'workflow_dispatch' || (github.event.deployment_status.state == 'success' &&\n (github.event.deployment_status.environment_url != '' ||\n  github.event.deployment_status.target_url != ''))" environment=None job_env_secrets=['VERCEL_AUTOMATION_BYPASS_SECRET'] permissions=(workflow)
    checkout persist-credentials=False ref=DEFAULT(event ref)
    step 'Resolve a URL a verificar': secrets=['VERCEL_AUTOMATION_BYPASS_SECRET'] runs_repo_code=[]
    step 'Headers, allowlist e configuração do Supabase': secrets=['VERCEL_AUTOMATION_BYPASS_SECRET'] runs_repo_code=['scripts/check_deploy.mjs']

