## .github/workflows/backup-private.yml
  triggers=['workflow_dispatch'] permissions={'contents': 'read'}
  job backup: if=None environment=None job_env_secrets=[] permissions=(workflow)
    checkout persist-credentials=False ref=DEFAULT(event ref)
    step 'Exigir os dois secrets antes de acessar o banco': secrets=['BACKUP_AGE_PUBLIC_KEY', 'SUPABASE_BACKUP_DATABASE_URL'] runs_repo_code=[]
    step 'Dump, restauração, todas as contagens e criptografia': secrets=['BACKUP_AGE_PUBLIC_KEY', 'SUPABASE_BACKUP_DATABASE_URL'] runs_repo_code=['scripts/backup_private.py']

