
## .github/workflows/atualizar-baseline.yml
  triggers=['workflow_dispatch'] permissions={'contents': 'write', 'pull-requests': 'write'}
  job medir: if=None environment=None job_env_secrets=[] permissions=(workflow)
    checkout persist-credentials=DEFAULT(true) ref=DEFAULT(event ref)
    step 'Medir e escrever o slot': secrets=['SUPABASE_PROD_AUDIT_DATABASE_URL', 'SUPABASE_TEST_AUDIT_DATABASE_URL'] runs_repo_code=['scripts/check_data_quality.mjs', 'scripts/check_grants.mjs']
    step 'Abrir o PR com o diff': secrets=['GITHUB_TOKEN'] runs_repo_code=[]

